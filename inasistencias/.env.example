# Variables del stack de Portainer (inasistencias). No se versiona el .env real.
# En el server: procom-migracion-pj/scripts/nuevo-entorno.sh inasistencias <test|prod>
# genera /srv/pj/env/inasistencias-<entorno>.env ({{ENTORNO}}, {{SUF}} y secretos).
# Para Portainer: scripts/vars-portainer.sh inasistencias <entorno> (sin ORIGEN_* ni TABLAS).

ENTORNO={{ENTORNO}}

# Hostname publicado por Traefik (DNS interno del PJ -> IP del servidor).
WEB_HOST=inasistencias{{SUF}}.justiciacordoba.gob.ar

# ---------- Secretos ----------
# Los agrega nuevo-entorno.sh: POSTGRES_PASSWORD, JWT_SECRET, ANON_KEY (y otros
# que este stack no usa).

# ---------- Migración (sólo en el archivo del server, NO en Portainer) ----------
ORIGEN_DB_URL=
TABLAS=usuarios solicitudes motivos comentarios_solicitudes
