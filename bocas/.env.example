# Variables del stack de Portainer (bocas). No se versiona el .env real.
# En el server: procom-migracion-pj/scripts/nuevo-entorno.sh bocas <test|prod>
# genera /srv/pj/env/bocas-<entorno>.env ({{ENTORNO}}, {{SUF}} y secretos).
# Para Portainer: scripts/vars-portainer.sh bocas <entorno> (sin ORIGEN_* ni TABLAS).

ENTORNO={{ENTORNO}}

# Hostnames publicados por Traefik (DNS interno del PJ -> IP del servidor).
WEB_HOST=bocas{{SUF}}.justiciacordoba.gob.ar
API_HOST=api-bocas{{SUF}}.justiciacordoba.gob.ar

# URL pública de PostgREST (sin /rest/v1: lo agrega supabase-js).
# Se embebe en la imagen web al construir.
SUPABASE_PUBLIC_URL=https://api-bocas{{SUF}}.justiciacordoba.gob.ar

# ---------- Secretos ----------
# Los agrega nuevo-entorno.sh: POSTGRES_PASSWORD, JWT_SECRET, ANON_KEY (y otros
# que este stack no usa).

# ---------- Migración (sólo en el archivo del server, NO en Portainer) ----------
ORIGEN_DB_URL=
TABLAS=bocas bienes_informaticos
