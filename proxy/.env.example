# Los hostnames de cada app están en el .env de la app (WEB_HOST / API_HOST).
# El certificado en ./certs tiene que cubrirlos todos (wildcard *.dominio o SAN).

# Rangos desde los que se permite abrir Supabase Studio (separados por espacio).
# Obligatorio: vacío deja a solo-admin sin rangos. Tras cambiarlo:
# docker compose up -d (recrea el contenedor; restart no relee el .env).
ADMIN_CIDR=10.0.0.0/24
