# Variables del stack de Portainer (horas-extra). No se versiona el .env real.
# En el server: procom-migracion-pj/scripts/nuevo-entorno.sh horas-extra <test|prod>
# genera /srv/pj/env/horas-extra-<entorno>.env reemplazando {{ENTORNO}} y
# {{SUF}} ("-test" en testing, vacío en producción) y agregando los secretos.
# Para Portainer: scripts/vars-portainer.sh horas-extra <entorno> (sin ORIGEN_*).

ENTORNO={{ENTORNO}}

# Hostnames publicados por Traefik (DNS interno del PJ -> IP del servidor).
WEB_HOST=horas{{SUF}}.justiciacordoba.gob.ar
API_HOST=api-horas{{SUF}}.justiciacordoba.gob.ar

SUPABASE_PUBLIC_URL=https://api-horas{{SUF}}.justiciacordoba.gob.ar
API_EXTERNAL_URL=https://api-horas{{SUF}}.justiciacordoba.gob.ar/auth/v1
# También es NEXT_PUBLIC_SITE_URL (link de los mails); se embebe en el build.
SITE_URL=https://horas{{SUF}}.justiciacordoba.gob.ar
ADDITIONAL_REDIRECT_URLS=https://horas{{SUF}}.justiciacordoba.gob.ar/auth/callback,https://horas{{SUF}}.justiciacordoba.gob.ar/**

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
JWT_EXPIRY=3600

DASHBOARD_USERNAME=admin-pj

# Google OAuth (Google Cloud Console > Credentials > OAuth Client ID).
# Agregar como Authorized redirect URI, uno por entorno:
#   https://api-horas{{SUF}}.justiciacordoba.gob.ar/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# Mails de la app (nodemailer). Hoy Brevo; se puede apuntar al relay del PJ.
# OJO en testing: con datos reales restaurados, los mails llegan a usuarios
# reales. Usar un SMTP de prueba o dejar SMTP_USER vacío si no se prueba mail.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Logística PJ <logisticapjcordoba@gmail.com>

# Cron del recordatorio (UTC). Vercel: "0 23 * * 0" = domingo 20:00 ART.
# En testing nuevo-entorno.sh lo deja en "0 0 31 2 *" (31 de febrero: nunca).
CRON_SCHEDULE=0 23 * * 0

# ---------- Secretos ----------
# Los agrega nuevo-entorno.sh (scripts/generar-claves.mjs): POSTGRES_PASSWORD,
# JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY, DASHBOARD_PASSWORD, PG_META_CRYPTO_KEY,
# SECRET_KEY_BASE, REALTIME_DB_ENC_KEY y CRON_SECRET.

# ---------- Migración (sólo en el archivo del server, NO en Portainer) ----------
ORIGEN_DB_URL=
