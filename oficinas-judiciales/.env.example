# Variables del stack de Portainer (oficinas-judiciales). No se versiona el .env real.
# En el server: procom-migracion-pj/scripts/nuevo-entorno.sh oficinas-judiciales <test|prod>
# genera /srv/pj/env/oficinas-judiciales-<entorno>.env ({{ENTORNO}} y {{SUF}}).

ENTORNO={{ENTORNO}}

# Hostname publicado por Traefik (DNS interno del PJ -> IP del servidor).
WEB_HOST=oficinas{{SUF}}.justiciacordoba.gob.ar

# API key de Resend (la de Vercel > Settings > Environment Variables).
# El servidor necesita salida HTTPS a api.resend.com.
# OJO: el código manda siempre a una casilla fija (app/actions.ts) desde el
# remitente de prueba de Resend; en testing los mails llegan a esa misma casilla.
RESEND_API_KEY=
