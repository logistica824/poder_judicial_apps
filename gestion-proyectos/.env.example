# Variables del stack de Portainer (gestion-proyectos). No se versiona el .env real.
# En el server: procom-migracion-pj/scripts/nuevo-entorno.sh gestion-proyectos <test|prod>
# genera /srv/pj/env/gestion-proyectos-<entorno>.env reemplazando {{ENTORNO}} y
# {{SUF}} ("-test" en testing, vacío en producción) y agregando los secretos.
# Ese archivo se pega en Portainer > stack > Environment variables > Advanced mode.

ENTORNO={{ENTORNO}}

# Hostnames publicados por Traefik (DNS interno del PJ -> IP del servidor).
WEB_HOST=gestion{{SUF}}.justiciacordoba.gob.ar
API_HOST=api-gestion{{SUF}}.justiciacordoba.gob.ar

# URL pública del gateway Supabase: la usan el navegador y el servidor Next.
# Se embebe en la imagen web al construir: si cambia, redeploy (rebuild).
SUPABASE_PUBLIC_URL=https://api-gestion{{SUF}}.justiciacordoba.gob.ar
API_EXTERNAL_URL=https://api-gestion{{SUF}}.justiciacordoba.gob.ar/auth/v1
SITE_URL=https://gestion{{SUF}}.justiciacordoba.gob.ar
ADDITIONAL_REDIRECT_URLS=https://gestion{{SUF}}.justiciacordoba.gob.ar/**

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
JWT_EXPIRY=3600

DASHBOARD_USERNAME=admin-pj

# SMTP para GoTrue (opcional: recuperación de contraseña). Relay del PJ.
SMTP_ADMIN_EMAIL=no-responder@justiciacordoba.gob.ar
SMTP_HOST=relay.justiciacordoba.gob.ar
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Gestión de Proyectos PJ

# ---------- Secretos ----------
# Los agrega nuevo-entorno.sh (scripts/generar-claves.mjs): POSTGRES_PASSWORD,
# JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY, DASHBOARD_PASSWORD, PG_META_CRYPTO_KEY,
# S3_PROTOCOL_ACCESS_KEY_ID/SECRET. Distintos en testing y en producción.

# ---------- Migración (sólo en el archivo del server, NO en Portainer) ----------
# Los usan dump.sh / restore.sh / migrar-storage.sh. Borrar después del corte.
# Connection string del proyecto Supabase Cloud (Dashboard > Connect > Session pooler).
ORIGEN_DB_URL=
ORIGEN_SUPABASE_URL=https://xcsbtbzrejdxyrexaesy.supabase.co
ORIGEN_SERVICE_ROLE_KEY=
